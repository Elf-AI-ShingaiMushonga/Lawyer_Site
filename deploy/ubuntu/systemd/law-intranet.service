[Unit]
Description=Law Firm Intranet (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/law_firm_intranet
EnvironmentFile=/home/ubuntu/law_firm_intranet/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/law_firm_intranet/venv/bin/gunicorn \
  -c /home/ubuntu/law_firm_intranet/deploy/ubuntu/gunicorn.conf.py \
  app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
