[Unit]
Description=DM-Inc Intranet Scheduler
After=network-online.target redis-server.service law-intranet.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Lawyer_Site
EnvironmentFile=/home/ubuntu/Lawyer_Site/.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/home/ubuntu/Lawyer_Site/venv/bin/python /home/ubuntu/Lawyer_Site/app.py scheduler --seed-defaults --loop --sleep-seconds 30
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
