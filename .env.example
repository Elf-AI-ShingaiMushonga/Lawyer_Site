# Runtime (Ubuntu production)
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Used by `python app.py run` (Gunicorn/systemd uses its own bind in deploy files)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database (AWS RDS PostgreSQL - recommended)
# Get these from RDS:
# - DB_HOST: Endpoint
# - DB_USER / DB_PASSWORD: master or app user credentials
# - DB_NAME: your database name (example: lawyer_site)
# If password has special chars (@:/?#[]), URL-encode it.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/lawyer_site?sslmode=require
# Local fallback example (single VM only):
# DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@127.0.0.1:5432/lawyer_site
# Required in production for encrypted backup artifacts (AES-256-GCM).
# Generate with:
# python3 - <<'PY'
# import base64, os
# print(base64.urlsafe_b64encode(os.urandom(32)).decode())
# PY
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Session and uploads
SESSION_TTL_MINUTES=480
# Persist session heartbeat at most once per interval per active user session.
SESSION_TOUCH_INTERVAL_SECONDS=60
MAX_UPLOAD_BYTES=52428800
UPLOAD_DIR=uploads

# Reverse proxy / HTTPS (Nginx, optionally ALB in front)
TRUST_PROXY=true
# 1 for Nginx only, 2 for Client -> ALB -> Nginx -> Gunicorn
TRUSTED_PROXY_HOPS=1
FORCE_SECURE_COOKIE=true

# Auth rate limiting (Flask-Limiter)
# `memory://` is acceptable for local dev and single-worker deployments.
# For multi-worker production, use Redis:
# RATE_LIMIT_STORAGE_URI=memory://
# If RATE_LIMIT_STORAGE_URI=memory:// and GUNICORN_WORKERS>1, app startup will fail unless
# ALLOW_IN_MEMORY_RATELIMIT=true (not recommended).
RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATE_LIMIT_STRATEGY=fixed-window
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=5/hour
PORTAL_LOGIN_RATE_LIMIT=10/minute
AUTH_SSO_TOKEN_RATE_LIMIT=60/minute
# Set only if you intentionally accept weaker per-process limits in multi-worker mode.
ALLOW_IN_MEMORY_RATELIMIT=false

# Gunicorn tuning
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Schema compatibility sync is a development fallback and should remain false in production.
ENABLE_SCHEMA_COMPAT_SYNC=false

# Background job loop controls (used by worker/scheduler services).
WORKER_LOOP_SLEEP_SECONDS=3
SCHEDULER_LOOP_SLEEP_SECONDS=30
