# Runtime
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-long-random-secret
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://app_user:app_password@db-host:5432/law_intranet
DB_POOL_RECYCLE_SECONDS=1800

# Session and uploads
SESSION_TTL_MINUTES=480
MAX_UPLOAD_BYTES=52428800
UPLOAD_DIR=uploads

# Proxy/HTTPS
TRUST_PROXY=true
FORCE_SECURE_COOKIE=true
